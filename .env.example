# Copy to .env.local and fill in. Never commit real values.

# Encrypts license keys and other secrets in the database. Required in production.
# Generate with: openssl rand -base64 32
# Losing or changing it makes stored secrets unreadable.
SECRET_KEY=

# Database file (default: ./data/app.db)
# DATABASE_PATH=

# Set to 1 only when serving over plain HTTP on a trusted LAN.
# ALLOW_INSECURE_COOKIE=

# Public address used in QR labels, e.g. https://itys.example.com
# Without it the address of the current request is used.
# APP_URL=

# Set to 1 to switch off the background expiry check and notification delivery.
# DISABLE_SCHEDULER=

# Number of reverse proxies (nginx, Caddy, a load balancer) in front of the app.
# Needed for the sign-in attempt limit to see the real client address; 0 when there is none.
# TRUSTED_PROXY_COUNT=0
